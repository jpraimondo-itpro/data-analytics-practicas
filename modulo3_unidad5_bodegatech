-- ── SECCIÓN DDL ──────────────────────────
-- DROP TABLE
DROP TABLE IF EXISTS inventario;
-- CREATE TABLE
CREATE TABLE inventario (
id_producto INT NOT NULL IDENTITY (1,1) PRIMARY KEY,
-- La línea anterior representa la creación del PK de la tabla con integridad automática
nombre_producto VARCHAR (100) NOT NULL,
-- El nombre del producto con un límite de 100 caractéres y no puede estar vacío
categoria VARCHAR (50),
-- Esta columna debería ser una FOREIGN KEY de otra tabla con ese nombre
precio_unitario DECIMAL (10,2) NOT NULL,
stock_actual INT NOT NULL,
stock_minimo INT NOT NULL,
fecha_ingreso DATE NOT NULL,
activo BIT NOT NULL
)
-- ── SECCIÓN DML ──────────────────────────
